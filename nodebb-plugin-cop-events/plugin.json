{
  "id": "nodebb-plugin-cop-events",
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "filter:topics.get", "method": "addSectorLabels" },
    { "hook": "filter:topic.get", "method": "addSectorLabelSingle" },
    { "hook": "filter:admin.header.build", "method": "addAdminNavigation" }
  ],
  "scripts": [
    "public/js/events.js"
  ],
  "modules": {
    "../admin/plugins/cop-events.js": "./public/js/admin/plugins/cop-events.js"
  },
  "scss": [
    "scss/events.scss"
  ],
  "staticDirs": {
    "cop-events": "public"
  },
  "languages": "languages"
}
