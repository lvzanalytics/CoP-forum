{
  "id": "nodebb-theme-cop",
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
    { "hook": "filter:widgets.getAreas", "method": "defineWidgetAreas" },
    { "hook": "filter:config.get", "method": "getThemeConfig" },
    { "hook": "filter:middleware.renderHeader", "method": "filterMiddlewareRenderHeader" },
    { "hook": "action:homepage.get:landing", "method": "onHomepageGet" },
    { "hook": "filter:homepage.get", "method": "addHomepageRoute" }
  ],
  "scripts": [
    "public/cop.js",
    "public/landing.js",
    "public/js/cop-relabel.js"
  ],
  "acpScripts": [
    "public/js/cop-relabel.js"
  ],
  "staticDirs": {
    "inter": "node_modules/@fontsource/inter/files",
    "cop": "public"
  },
  "languages": "languages"
}
